# ====================================
# EMPLOYEE TASK API - ENVIRONMENT VARIABLES
# ====================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to git - it contains secrets!

# ====================================
# APPLICATION SETTINGS
# ====================================
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ====================================
# SECURITY - GENERATE NEW SECRETS!
# ====================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-new-one
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-different-one

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds

# ====================================
# DATABASE
# ====================================
# Development (SQLite)
DATABASE_URL=sqlite:///D:/employee-task-api/instance/app.db

# Production (PostgreSQL - Render/Railway will provide this)
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# ====================================
# REDIS (Optional - for caching and rate limiting)
# ====================================
# Development
REDIS_URL=redis://localhost:6379/0

# Production (Render/Railway will provide this if you add Redis)
# REDIS_URL=redis://default:password@host:6379

# ====================================
# SECURITY & CORS
# ====================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://
# For production with Redis: RATELIMIT_STORAGE_URL=redis://localhost:6379

# ====================================
# APPLICATION SETTINGS
# ====================================
MAX_CONTENT_LENGTH=16777216  # 16MB

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ====================================
# MONITORING & LOGGING
# ====================================
# Sentry DSN (optional - for error tracking)
# Get from https://sentry.io after creating a project
SENTRY_DSN=

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ====================================
# EMAIL (Optional - for future features)
# ====================================
# SMTP Configuration
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@yourapp.com

# ====================================
# TESTING
# ====================================
# Set to 1 to enable testing mode
# TESTING=0
